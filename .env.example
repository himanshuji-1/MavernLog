# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (legacy) key or the publishable key (sb_publishable_...). Safe for the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Added in later phases (server-only, never prefix with NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=   (seed script only, run locally. Supabase → API → secret key. NEVER commit or deploy it.)
# Gemini quick log + "Explain this" (server-only; get a key at https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   (optional override, e.g. gemini-3.8-flash)
